<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form.inherit.sale_distribution</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_view_distribution_accruals" type="object" class="oe_stat_button" icon="pie_chart"
                    invisible="not distribution_accrual_count">
                    <field name="distribution_accrual_count" widget="statinfo" string="Provisioned"/>
                </button>
            </div>
        </field>
    </record>

</odoo>
