<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_distribution_view_list" model="ir.ui.view">
        <field name="name">sale.distribution.list</field>
        <field name="model">sale.distribution</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="is_default"/>
                <field name="total_percentage"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="sale_distribution_view_form" model="ir.ui.view">
        <field name="name">sale.distribution.form</field>
        <field name="model">sale.distribution</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="alert alert-info" role="status" invisible="not is_used">
                        This scheme already has provision entries: its rules cannot be changed.
                        Archive it and create a new scheme instead.
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="is_default"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="total_percentage"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="rule_ids" readonly="is_used">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="role"/>
                            <field name="percentage"/>
                            <field name="expense_account_id" invisible="role == 'company'"/>
                            <field name="payable_account_id" invisible="role == 'company'"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sale_distribution_view_search" model="ir.ui.view">
        <field name="name">sale.distribution.search</field>
        <field name="model">sale.distribution</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="sale_distribution_action" model="ir.actions.act_window">
        <field name="name">Distribution Schemes</field>
        <field name="res_model">sale.distribution</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
