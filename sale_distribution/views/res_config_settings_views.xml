<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.sale_distribution</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block name="catalog_setting_container" position="before">
                <block title="Distribution" name="distribution_setting_container">
                    <setting id="distribution_accounting" string="Provisions"
                        help="Journal of the provision entries and product of the commission purchases">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="distribution_journal_id" class="col-lg-5 o_light_label"/>
                                <field name="distribution_journal_id"/>
                            </div>
                            <div class="row">
                                <label for="distribution_commission_product_id" class="col-lg-5 o_light_label"/>
                                <field name="distribution_commission_product_id"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="distribution_schemes" string="Distribution Schemes"
                        help="How each payment is split between salespeople, implementers and the company">
                        <button name="%(sale_distribution.sale_distribution_action)d" type="action"
                            string="Schemes" class="btn-link" icon="east"/>
                    </setting>
                </block>
            </block>
        </field>
    </record>

</odoo>
