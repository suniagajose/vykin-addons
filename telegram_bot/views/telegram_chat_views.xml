<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_telegram_chat_list" model="ir.ui.view">
        <field name="name">telegram.chat.list</field>
        <field name="model">telegram.chat</field>
        <field name="arch" type="xml">
            <list string="Telegram Chats" create="False">
                <field name="bot_id" />
                <field name="chat_id" />
                <field name="chat_type" />
                <field name="telegram_user_id" />
                <field name="telegram_username" />
                <field name="partner_id" />
                <field name="state" />
                <field name="last_message_time" />
            </list>
        </field>
    </record>

    <record id="view_telegram_chat_form" model="ir.ui.view">
        <field name="name">telegram.chat.form</field>
        <field name="model">telegram.chat</field>
        <field name="arch" type="xml">
            <form string="Telegram Chat" create="False">
                <sheet>
                    <group>
                        <group>
                            <field name="bot_id" />
                            <field name="chat_id" />
                            <field name="chat_type" />
                            <field name="telegram_user_id" />
                            <field name="telegram_username" />
                            <field name="partner_id" />
                        </group>
                        <group>
                            <field name="state" />
                            <field name="last_state_change" />
                            <field name="last_message_time" />
                            <field name="failed_command_count" />
                            <field name="last_error" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_telegram_chat" model="ir.actions.act_window">
        <field name="name">Chats</field>
        <field name="res_model">telegram.chat</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
