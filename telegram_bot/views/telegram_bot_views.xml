<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_telegram_bot_list" model="ir.ui.view">
        <field name="name">telegram.bot.list</field>
        <field name="model">telegram.bot</field>
        <field name="arch" type="xml">
            <list string="Telegram Bots">
                <field name="name" />
            </list>
        </field>
    </record>

    <record id="view_telegram_bot_form" model="ir.ui.view">
        <field name="name">telegram.bot.form</field>
        <field name="model">telegram.bot</field>
        <field name="arch" type="xml">
            <form string="Telegram Bot">
                <header>
                    <button
                        name="action_register_webhook"
                        type="object"
                        string="Register webhook"
                        class="btn-primary"
                        groups="base.group_system"
                        help="Tell Telegram to send this bot's updates to this database, with the secret (generated if empty)."
                    />
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="bot_token" password="True" groups="base.group_system" />
                        </group>
                        <group>
                            <field name="webhook_secret" password="True" groups="base.group_system" />
                            <field name="command_ids" widget="many2many_tags" options="{'no_create': True}" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Chats" name="chats">
                            <field name="chat_ids" readonly="1">
                                <list>
                                    <field name="chat_id" />
                                    <field name="chat_type" />
                                    <field name="telegram_user_id" />
                                    <field name="telegram_username" />
                                    <field name="partner_id" />
                                    <field name="state" />
                                    <field name="last_message_time" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_telegram_bot" model="ir.actions.act_window">
        <field name="name">Telegram Bots</field>
        <field name="res_model">telegram.bot</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
