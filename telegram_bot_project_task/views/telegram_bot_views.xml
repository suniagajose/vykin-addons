<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_telegram_bot_form" model="ir.ui.view">
        <field name="name">telegram.bot.form.project.task</field>
        <field name="model">telegram.bot</field>
        <field name="inherit_id" ref="telegram_bot.view_telegram_bot_form" />
        <field name="arch" type="xml">
            <page name="ai" position="after">
                <page string="Tasks" name="project_task">
                    <group>
                        <group>
                            <field name="project_task_project_id" placeholder="The user picks one" />
                        </group>
                    </group>
                    <field
                        name="project_task_glossary"
                        placeholder="Odoo, Vykin, CRM, Knowledge, ..."
                    />
                </page>
            </page>
        </field>
    </record>

</odoo>
