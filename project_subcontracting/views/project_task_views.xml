<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_task_form2_inherited" model="ir.ui.view">
        <field name="name">project.task.form.inherit.project_subcontracting</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="hr_timesheet.view_task_form2_inherited"/>
        <field name="arch" type="xml">
            <xpath expr="//t[@name='warning_section']" position="inside">
                <div class="alert alert-warning mb-2" role="alert" invisible="not subcontracting_warning">
                    <field name="subcontracting_warning" nolabel="1"/>
                </div>
            </xpath>
            <xpath expr="//div[@id='allocated_hours_container']" position="after">
                <field name="subcontracting_currency_id" invisible="1"/>
                <field name="subcontracting_hour_cost" invisible="not allow_subcontracting"/>
            </xpath>
            <xpath expr="//field[@name='timesheet_ids']/list/field[@name='unit_amount']" position="after">
                <field name="subcontracting_bill_id" optional="hide" groups="account.group_account_invoice"
                    column_invisible="not parent.allow_subcontracting"/>
            </xpath>
        </field>
    </record>

</odoo>
