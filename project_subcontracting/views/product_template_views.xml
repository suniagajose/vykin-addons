<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form.inherit.project_subcontracting</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="property_account_expense_id" position="after">
                <field name="property_provision_commission_id" placeholder="From Category"
                    groups="account.group_account_readonly"/>
                <field name="property_provision_implementation_id" placeholder="From Category"
                    groups="account.group_account_readonly"/>
            </field>
        </field>
    </record>

</odoo>
